  "components": {
    "schemas": {
      "CollectionMetadata": {
        "type": "object",
        "required": [
          "name",
          "dimension",
          "metric",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "dimension": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "metadata_schema": {},
          "metric": {
            "$ref": "#/components/schemas/Metric"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CollectionStatsResponse": {
        "type": "object",
        "required": [
          "dimension",
          "vector_count",
          "segments",
          "generation"
        ],
        "properties": {
          "dimension": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "generation": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "segments": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "vector_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CreateCollectionRequest": {
        "type": "object",
        "required": [
          "name",
          "dimension"
        ],
        "properties": {
          "dimension": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "metadata_schema": {},
          "metric": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Metric"
              }
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DeleteCollectionResponse": {
        "type": "object",
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "properties": {
          "delete_all": {
            "type": "boolean"
          },
          "filter": {},
          "ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeleteResponse": {
        "type": "object",
        "required": [
          "deleted_count"
        ],
        "properties": {
          "deleted_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {},
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "FetchRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "include_metadata": {
            "type": "boolean"
          },
          "include_values": {
            "type": "boolean"
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FetchResponse": {
        "type": "object",
        "required": [
          "vectors",
          "namespace"
        ],
        "properties": {
          "namespace": {
            "type": "string"
          },
          "vectors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FetchVector"
            }
          }
        }
      },
      "FetchVector": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "metadata": {},
          "values": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "format": "float"
            }
          }
        }
      },
      "FilterCacheMetricsSnapshot": {
        "type": "object",
        "required": [
          "cluster_hits",
          "cluster_misses",
          "cluster_evictions",
          "row_hits",
          "row_misses",
          "row_evictions"
        ],
        "properties": {
          "cluster_evictions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cluster_hits": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "cluster_misses": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "row_evictions": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "row_hits": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "row_misses": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ListCollectionsResponse": {
        "type": "object",
        "required": [
          "collections"
        ],
        "properties": {
          "collections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionMetadata"
            }
          }
        }
      },
      "Metric": {
        "type": "string",
        "enum": [
          "cosine",
          "dot",
          "euclidean"
        ]
      },
      "OperationApplyStatus": {
        "type": "string",
        "enum": [
          "accepted",
          "applied"
        ]
      },
      "OperationStatusResponse": {
        "type": "object",
        "required": [
          "operation_id",
          "status",
          "accepted_at"
        ],
        "properties": {
          "accepted_at": {
            "type": "string"
          },
          "applied_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "operation_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OperationApplyStatus"
          }
        }
      },
      "QueryAnnObservability": {
        "type": "object",
        "required": [
